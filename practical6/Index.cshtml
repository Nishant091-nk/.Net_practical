@model IEnumerable<ProductCatalogApp.Models.Product>

<!DOCTYPE html>
<html>
<head>
    <title>Product Catalog</title>
</head>
<body>
    <h2 style="text-align:center; font-family: Arial;">My Product Catalog</h2>

    <table border="1" style="width:100%; border-collapse: collapse; font-family: Arial; text-align: left;">
        <thead style="background-color: #333; color: white;">
            <tr>
                <th style="padding: 10px;">ID</th>
                <th style="padding: 10px;">Product Name</th>
                <th style="padding: 10px;">Category</th>
                <th style="padding: 10px;">Price (₹)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="padding: 10px;">@item.Id</td>
                    <td style="padding: 10px;">@item.Name</td>
                    <td style="padding: 10px;">@item.Category</td>
                    <td style="padding: 10px;">@item.Price</td>
                </tr>
            }
        </tbody>
    </table>
</body>
</html>
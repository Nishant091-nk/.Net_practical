@model eedbackApp.Models.Feedback

@using (Html.BeginForm("Submit", "Feedback", FormMethod.Post))
{
    <div style="margin-bottom: 15px;">
        @Html.LabelFor(m => m.Name) <br />
        @Html.TextBoxFor(m => m.Name)
        @Html.ValidationMessageFor(m => m.Name, "", new { @style = "color:red" })
    </div>

    <div style="margin-bottom: 15px;">
        @Html.LabelFor(m => m.Email) <br />
        @Html.TextBoxFor(m => m.Email)
        @Html.ValidationMessageFor(m => m.Email, "", new { @style = "color:red" })
    </div>

    <div style="margin-bottom: 15px;">
        @Html.LabelFor(m => m.Comments) <br />
        @Html.TextAreaFor(m => m.Comments)
        @Html.ValidationMessageFor(m => m.Comments, "", new { @style = "color:red" })
    </div>

    <button type="submit">Submit Feedback</button>
}
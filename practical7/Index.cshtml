@model eedbackApp.Models.Feedback
@{
    ViewBag.Title = "Industry Management Feedback";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Industry Management Feedback</title>
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');

        body {
            background: linear-gradient(135deg, #00c6ff 0%, #0072ff 40%, #764ba2 100%);
            font-family: 'Poppins', sans-serif;
            min-height: 100vh;
            margin: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px;
            box-sizing: border-box;
        }

        .main-heading {
            color: #ffffff;
            font-size: 38px;
            font-weight: 700;
            text-align: center;
            margin-bottom: 55px;
            text-shadow: 2px 2px 10px rgba(0,0,0,0.2);
            letter-spacing: 1px;
            z-index: 1;
        }

        .feedback-card {
            width: 100%;
            max-width: 480px;
            background: #ffffff;
            padding: 50px 40px 30px;
            border-radius: 16px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
            position: relative;
            z-index: 1;
            box-sizing: border-box;
        }

        .icon-wrapper {
            position: absolute;
            top: -40px;
            left: 50%;
            transform: translateX(-50%);
            background: #ffffff;
            width: 80px;
            height: 80px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            font-size: 35px;
        }

        .subtitle {
            text-align: center;
            color: #2c3e50;
            font-weight: 600;
            margin-bottom: 25px;
            font-size: 16px;
        }

        label {
            font-weight: 500;
            color: #4a4a4a;
            font-size: 13px;
            margin-bottom: 5px;
            display: block;
        }

        input[type="text"], textarea {
            width: 100%;
            padding: 12px 15px;
            margin-top: 4px;
            margin-bottom: 15px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            box-sizing: border-box;
            font-size: 14px;
            font-family: 'Poppins', sans-serif;
            background-color: #f9fafb;
            transition: all 0.3s;
        }

            input[type="text"]:focus, textarea:focus {
                border-color: #5b21b6;
                background-color: #ffffff;
                outline: none;
                box-shadow: 0 0 0 3px rgba(91, 33, 182, 0.15);
            }

        button[type="submit"] {
            background: linear-gradient(135deg, #1e3a8a 0%, #6d28d9 100%);
            color: white;
            border: none;
            padding: 14px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 15px;
            font-weight: 600;
            width: 100%;
            margin-top: 15px;
            transition: transform 0.2s, box-shadow 0.2s;
        }

            button[type="submit"]:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(109, 40, 217, 0.4);
            }

        .footer-note {
            text-align: center;
            font-size: 12px;
            color: #888;
            margin-top: 20px;
        }

        span[style*="color:red"] {
            font-size: 12px;
            color: #e74c3c !important;
            display: block;
            margin-top: -10px;
            margin-bottom: 10px;
        }

        .success-message {
            color: #155724;
            background-color: #d4edda;
            padding: 12px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-size: 14px;
            text-align: center;
            border: 1px solid #c3e6cb;
        }
    </style>
</head>
<body>

    <h1 class="main-heading">Industry Management Feedback</h1>

    <div class="feedback-card">
        <div class="icon-wrapper">
            💬
        </div>

        <p class="subtitle">Your feedback helps us improve our services</p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="success-message">
                <strong>✓ @TempData["SuccessMessage"]</strong>
            </div>
        }

        @Html.Partial("FeedbackForm", Model)

        <p class="footer-note">Your responses are secure & confidential.</p>
    </div>

</body>
</html>